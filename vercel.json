{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/app.css", "dest": "/app.css" },
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
